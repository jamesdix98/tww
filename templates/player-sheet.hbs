        <h2>INTELLIGENCE</h2>

        <button
          type="button"
          class="stat-roll-button attribute-button rollable"
          data-type="attribute"
          data-roll="intelligence">
          {{signed system.attributes.intelligence}}
        </button>

        <div class="save-row">

          <span class="proficient-roll-prof">
            {{#if system.saves.intelligence.proficient}}●{{else}}○{{/if}}
          </span>

          <span>SAVE:</span>

          <button
            type="button"
            class="save-roll-button rollable"
            data-type="save"
            data-roll="intelligence">
            {{signed system.saves.intelligence.bonus}}
          </button>

        </div>

      </div>


      <!-- WISDOM -->
      <div class="header-attribute">

        <h2>WISDOM</h2>

        <button
          type="button"
          class="stat-roll-button attribute-button rollable"
          data-type="attribute"
          data-roll="wisdom">
          {{signed system.attributes.wisdom}}
        </button>

        <div class="save-row">

          <span class="proficient-roll-prof">
            {{#if system.saves.wisdom.proficient}}●{{else}}○{{/if}}
          </span>

          <span>SAVE:</span>

          <button
            type="button"
            class="save-roll-button rollable"
            data-type="save"
            data-roll="wisdom">
            {{signed system.saves.wisdom.bonus}}
          </button>

        </div>

      </div>


      <!-- PRESENCE -->
      <div class="header-attribute">

        <h2>PRESENCE</h2>

        <button
          type="button"
          class="stat-roll-button attribute-button rollable"
          data-type="attribute"
          data-roll="presence">
          {{signed system.attributes.presence}}
        </button>

        <div class="save-row">

          <span class="proficient-roll-prof">
            {{#if system.saves.presence.proficient}}●{{else}}○{{/if}}
          </span>

          <span>SAVE:</span>

          <button
            type="button"
            class="save-roll-button rollable"
            data-type="save"
            data-roll="presence">
            {{signed system.saves.presence.bonus}}
          </button>

        </div>

      </div>


    </div>

  </section>

  <section class="skills-section">

  <! strength skills >
  {{#each skillSections.strength}}
    <div class="proficient-roll">

      <span class="proficient-roll-prof">
        {{#if expertise}}
          ◉
        {{else if proficient}}
          ●
        {{else}}
          ○
        {{/if}}
      </span>

      <span class="proficient-roll-title">
        {{name}}
      </span>

      <button
        type="button"
        class="proficient-roll-button rollable"
        data-type="skill"
        data-roll="{{key}}">
        {{signed bonus}}
      </button>

    </div>
  {{/each}}
  
  <! agility skills >
  {{#each skillSections.agility}}
    <div class="proficient-roll">

      <span class="proficient-roll-prof">
