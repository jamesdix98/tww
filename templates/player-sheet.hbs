<form autocomplete="off" class="character-sheet">

  <header class="sheet-header">

    <!-- Character image and name -->
    <div class="character-info">

      <img
        src="{{actor.img}}"
        alt="{{actor.name}}"
        class="character-image"
      >

      <h1>{{actor.name}}</h1>

    </div>

  </header>


  <!-- Attributes -->
  <section class="attribute-section">

    <div class="attribute-header-boxes">


      <!-- STRENGTH -->
      <div class="header-attribute">

        <h2>STRENGTH</h2>

        <button
          type="button"
          class="stat-roll-button attribute-button rollable"
          data-type="attribute"
          data-roll="strength">
          {{signed system.attributes.strength}}
        </button>

        <div class="save-row">

          <span class="proficient-roll-prof">
            {{#if system.saves.strength.proficient}}●{{else}}○{{/if}}
          </span>

          <span>SAVE:</span>

          <button
            type="button"
            class="save-roll-button rollable"
            data-type="save"
            data-roll="strength">
            {{signed system.saves.strength.bonus}}
          </button>

        </div>

      </div>


      <!-- AGILITY -->
      <div class="header-attribute">

        <h2>AGILITY</h2>

        <button
          type="button"
          class="stat-roll-button attribute-button rollable"
          data-type="attribute"
          data-roll="agility">
          {{signed system.attributes.agility}}
        </button>

        <div class="save-row">

          <span class="proficient-roll-prof">
            {{#if system.saves.agility.proficient}}●{{else}}○{{/if}}
          </span>

          <span>SAVE:</span>

          <button
            type="button"
            class="save-roll-button rollable"
            data-type="save"
            data-roll="agility">
            {{signed system.saves.agility.bonus}}
          </button>

        </div>

      </div>


      <!-- HEALTH -->
      <div class="header-attribute">

        <h2>HEALTH</h2>

        <button
          type="button"
          class="stat-roll-button attribute-button rollable"
          data-type="attribute"
          data-roll="health">
          {{signed system.attributes.health}}
        </button>

        <div class="save-row">

          <span class="proficient-roll-prof">
            {{#if system.saves.health.proficient}}●{{else}}○{{/if}}
          </span>

          <span>SAVE:</span>

          <button
            type="button"
            class="save-roll-button rollable"
            data-type="save"
            data-roll="health">
            {{signed system.saves.health.bonus}}
          </button>

        </div>

      </div>


      <!-- INTELLIGENCE -->
      <div class="header-attribute">

        <h2>INTELLIGENCE</h2>

        <button
          type="button"
          class="stat-roll-button attribute-button rollable"
          data-type="attribute"
          data-roll="intelligence">
          {{signed system.attributes.intelligence}}
        </button>

        <div class="save-row">

          <span class="proficient-roll-prof">
            {{#if system.saves.intelligence.proficient}}●{{else}}○{{/if}}
          </span>

          <span>SAVE:</span>

          <button
            type="button"
            class="save-roll-button rollable"
            data-type="save"
            data-roll="intelligence">
            {{signed system.saves.intelligence.bonus}}
          </button>

        </div>

      </div>


      <!-- WISDOM -->
      <div class="header-attribute">

        <h2>WISDOM</h2>

        <button
          type="button"
          class="stat-roll-button attribute-button rollable"
          data-type="attribute"
          data-roll="wisdom">
          {{signed system.attributes.wisdom}}
        </button>

        <div class="save-row">

          <span class="proficient-roll-prof">
            {{#if system.saves.wisdom.proficient}}●{{else}}○{{/if}}
          </span>

          <span>SAVE:</span>

          <button
            type="button"
            class="save-roll-button rollable"
            data-type="save"
            data-roll="wisdom">
            {{signed system.saves.wisdom.bonus}}
          </button>

        </div>

      </div>


      <!-- PRESENCE -->
      <div class="header-attribute">

        <h2>PRESENCE</h2>

        <button
          type="button"
          class="stat-roll-button attribute-button rollable"
          data-type="attribute"
          data-roll="presence">
          {{signed system.attributes.presence}}
        </button>

        <div class="save-row">

          <span class="proficient-roll-prof">
            {{#if system.saves.presence.proficient}}●{{else}}○{{/if}}
          </span>

          <span>SAVE:</span>

          <button
            type="button"
            class="save-roll-button rollable"
            data-type="save"
            data-roll="presence">
            {{signed system.saves.presence.bonus}}
          </button>

        </div>

      </div>


    </div>

  </section>

  <section class="sheet-body">

  <!-- TAB BAR -->
  <nav class="sheet-tab-bar">

    <button
      type="button"
      class="sheet-tab active"
      data-tab="skills"
      title="Skills">
      <i class="fas fa-list"></i>
    </button>

    <button
      type="button"
      class="sheet-tab"
      data-tab="attacks"
      title="Attacks">
      <i class="fas fa-swords"></i>
    </button>

    <button
      type="button"
      class="sheet-tab"
      data-tab="spellcasting"
      title="Spellcasting">
      <i class="fas fa-wand-magic-sparkles"></i>
    </button>

    <button
      type="button"
      class="sheet-tab"
      data-tab="health-dice"
      title="Health Dice">
      <i class="fas fa-heart"></i>
    </button>

    <button
      type="button"
      class="sheet-tab"
      data-tab="equipment"
      title="Equipment">
      <i class="fas fa-backpack"></i>
    </button>

    <button
      type="button"
      class="sheet-tab"
      data-tab="features"
      title="Features">
      <i class="fas fa-star"></i>
    </button>

    <button
      type="button"
      class="sheet-tab"
      data-tab="notes"
      title="Notes">
      <i class="fas fa-note-sticky"></i>
    </button>

  </nav>


  <!-- TAB CONTENT -->

  <section class="sheet-tab-content">

    <!-- SKILLS -->
    <div
      class="tab-panel active"
      data-tab-content="skills">

      <h2>Skills</h2>

      <section class="skills-section">

  <!-- LEFT COLUMN -->
  <div class="skills-column">

    <!-- STRENGTH -->
    <div class="skill-group">
      <h3>STRENGTH</h3>

      {{#each skillSections.strength}}
        <div class="proficient-roll">

          <span class="proficient-roll-prof">
            {{#if expertise}}
              ◉
            {{else if proficient}}
              ●
            {{else}}
              ○
            {{/if}}
          </span>

          <span class="proficient-roll-title">
            {{name}}
          </span>

          <button
            type="button"
            class="proficient-roll-button rollable"
            data-type="skill"
            data-roll="{{key}}">
            {{signed bonus}}
          </button>

        </div>
      {{/each}}
    </div>


    <!-- AGILITY -->
    <div class="skill-group">
      <h3>AGILITY</h3>

      {{#each skillSections.agility}}
        <div class="proficient-roll">

          <span class="proficient-roll-prof">
            {{#if expertise}}
              ◉
            {{else if proficient}}
              ●
            {{else}}
              ○
            {{/if}}
          </span>

          <span class="proficient-roll-title">
            {{name}}
          </span>

          <button
            type="button"
            class="proficient-roll-button rollable"
            data-type="skill"
            data-roll="{{key}}">
            {{signed bonus}}
          </button>

        </div>
      {{/each}}
    </div>


    <!-- HEALTH -->
    <div class="skill-group">
      <h3>HEALTH</h3>

      {{#each skillSections.health}}
        <div class="proficient-roll">

          <span class="proficient-roll-prof">
            {{#if expertise}}
              ◉
            {{else if proficient}}
              ●
            {{else}}
              ○
            {{/if}}
          </span>

          <span class="proficient-roll-title">
            {{name}}
          </span>

          <button
            type="button"
            class="proficient-roll-button rollable"
            data-type="skill"
            data-roll="{{key}}">
            {{signed bonus}}
          </button>

        </div>
      {{/each}}
    </div>


    <!-- WISDOM -->
    <div class="skill-group">
      <h3>WISDOM</h3>

      {{#each skillSections.wisdom}}
        <div class="proficient-roll">

          <span class="proficient-roll-prof">
            {{#if expertise}}
              ◉
            {{else if proficient}}
              ●
            {{else}}
              ○
            {{/if}}
          </span>

          <span class="proficient-roll-title">
            {{name}}
          </span>

          <button
            type="button"
            class="proficient-roll-button rollable"
            data-type="skill"
            data-roll="{{key}}">
            {{signed bonus}}
          </button>

        </div>
      {{/each}}
    </div>

  </div>


  <!-- RIGHT COLUMN -->
  <div class="skills-column">

    <!-- INTELLIGENCE -->
    <div class="skill-group">
      <h3>INTELLIGENCE</h3>

      {{#each skillSections.intelligence}}
        <div class="proficient-roll">

          <span class="proficient-roll-prof">
            {{#if expertise}}
              ◉
            {{else if proficient}}
              ●
            {{else}}
              ○
            {{/if}}
          </span>

          <span class="proficient-roll-title">
            {{name}}
          </span>

          <button
            type="button"
            class="proficient-roll-button rollable"
            data-type="skill"
            data-roll="{{key}}">
            {{signed bonus}}
          </button>

        </div>
      {{/each}}
    </div>


    <!-- PRESENCE -->
    <div class="skill-group">
      <h3>PRESENCE</h3>

      {{#each skillSections.presence}}
        <div class="proficient-roll">

          <span class="proficient-roll-prof">
            {{#if expertise}}
              ◉
            {{else if proficient}}
              ●
            {{else}}
              ○
            {{/if}}
          </span>

          <span class="proficient-roll-title">
            {{name}}
          </span>

          <button
            type="button"
            class="proficient-roll-button rollable"
            data-type="skill"
            data-roll="{{key}}">
            {{signed bonus}}
          </button>

        </div>
      {{/each}}
    </div>

  </div>

</section>

    </div>


    <!-- ATTACKS -->
    <div
      class="tab-panel"
      data-tab-content="attacks">

      <h2>Attacks</h2>

    </div>


    <!-- SPELLCASTING -->
    <div
      class="tab-panel"
      data-tab-content="spellcasting">

      <h2>Spellcasting</h2>

    </div>


    <!-- HEALTH DICE -->
    <div
      class="tab-panel"
      data-tab-content="health-dice">

      <h2>Health Dice</h2>

    </div>


    <!-- EQUIPMENT -->
    <div
      class="tab-panel"
      data-tab-content="equipment">

      <h2>Equipment</h2>

    </div>


    <!-- FEATURES -->
    <div
      class="tab-panel"
      data-tab-content="features">

      <h2>Features</h2>

    </div>


    <!-- NOTES -->
    <div
      class="tab-panel"
      data-tab-content="notes">

      <h2>Notes</h2>

    </div>

  </section>

</section>


</form>