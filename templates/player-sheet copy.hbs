<form autocomplete="off" class="character-sheet">

  <header class="sheet-header">
    <h1>{{actor.name}}</h1>
  </header>

  <section class="sheet-columns">
    <section class="left-column">
      
      <! strength section >
      <section class="attribute-box">

        <! title and save >
        <div class="attribute-header">
          <! title >
          <h2>Strength</h2>

          <! saving throw >
          <div class="proficient-roll">
            <span class="proficient-roll-prof">
                {{#if system.saves.strength.proficient}}●{{else}}○{{/if}}
            </span>

            <span class="proficient-roll-title">
                Save:
            </span>

            <button
                class="proficient-roll-button rollable"
                data-type="save"
                data-roll="strength">
                {{signed system.saves.strength.bonus}}

            </button>
          </div>
        </div>

        <! main attrinute button >
        <button
          type="button"
          class="attribute-roll-button rollable"
          data-type="attribute"
          data-roll="strength">

          {{signed system.attributes.strength}}

        </button>

        <! skills section >
        <div class="skill-section">

          <! athletics >
          <div class="proficient-roll">

              <span class="proficient-roll-prof">
                  {{#if system.skills.athletics.proficient}}●{{else}}○{{/if}}
              </span>

              <span class="proficient-roll-title">
                  Athletics:
              </span>

              <button
                  class="proficient-roll-button rollable"
                  data-type="skill"
                  data-roll="athletics">

                  {{signed system.skills.athletics.bonus}}

              </button>

          </div>

        </div>
      </section>

